# ── Messenger Frontend — environment template ────────────────────────────────
# Copy this file to `.env.local` and fill in the values.

# Absolute base URL of the Messenger backend API (no trailing slash).
# Example: https://messenger.example.com
# If left unset the app runs in "gateway mode": all requests go to relative
# /api/v1/... paths with an XTransformPort parameter pointing at NEXT_PUBLIC_MOCK_API_PORT.
NEXT_PUBLIC_API_BASE_URL=

# Port of the mock/gateway service used in gateway mode (default: 3030).
NEXT_PUBLIC_MOCK_API_PORT=3030
